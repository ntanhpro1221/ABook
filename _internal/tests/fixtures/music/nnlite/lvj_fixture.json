  {
   "name": "một cảnh",
   "texts": [
    "Thanh kiếm chém xuống! Máu bắn tung toé. Hắn gầm lên, lao tới lần nữa – nhanh hơn, tàn bạo hơn!"
   ],
   "weights": [
    21
   ],
   "chapterP": [
    -0.00464792833527139,
    0.9561402606572459,
    0.3932429431628441,
    0.4326405683268242
   ],
   "level": [
