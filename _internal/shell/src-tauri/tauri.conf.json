{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ABook",
  "mainBinaryName": "ABook",
  "version": "../../ui/package.json",
  "identifier": "com.ngdtuanh.abook",
  "build": {
    "frontendDist": "../loading"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ABook",
        "url": "index.html",
        "width": 1320,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680,
        "backgroundColor": "#0e1115",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEREODQ3NUI4OTc2RjkzMjUKUldRbGsyK1h1SFdFM2RMR2traEx3dGtaamZIc1RSMDlHY0JzQnBLa3ordnpBQk5SZlZHTDYxQ3cK",
      "endpoints": ["https://github.com/ntanhpro1221/ABook/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["../../ebook_reader/assets/abook.ico", "../../ebook_reader/assets/abook.png"],
    "resources": ["resources/python/", "resources/app/"],
    "publisher": "ABook",
    "shortDescription": "Sách nói tiếng Việt",
    "fileAssociations": [
      {
        "ext": ["abook"],
        "name": "ABook",
        "description": "Sách nói ABook",
        "role": "Viewer",
        "mimeType": "application/vnd.ngdtuanh.abook+zip"
      }
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh",
        "installMode": "currentUser",
        "languages": ["Vietnamese"],
        "displayLanguageSelector": false
      }
    }
  }
}
