{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ABook",
  "mainBinaryName": "ABook",
  "version": "../../ui/package.json",
  "identifier": "com.ngdtuanh.abook",
  "build": {
    "frontendDist": "../loading"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ABook",
        "url": "index.html",
        "width": 1320,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680,
        "backgroundColor": "#0e1115"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../../ebook_reader/assets/ebook_reader.ico", "../../ebook_reader/assets/ebook_reader.png"],
    "publisher": "ABook",
    "shortDescription": "Sách nói tiếng Việt",
    "fileAssociations": [
      {
        "ext": ["abook"],
        "name": "ABook",
        "description": "Sách nói ABook",
        "role": "Viewer",
        "mimeType": "application/x-abook"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Vietnamese"],
        "displayLanguageSelector": false
      }
    }
  }
}
