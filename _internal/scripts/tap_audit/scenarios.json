[
  {
    "name": "Listen mobile - Add book",
    "path": "#/",
    "steps": [
      {
        "text": "Thêm sách",
        "exact": true
      }
    ],
    "probe": {
      "selector": "input[aria-label='Đường dẫn file hay thư mục']",
      "type": "input"
    },
    "background": {
      "text": "Thêm sách",
      "exact": true
    }
  },
  {
    "name": "Listen mobile - Find in book",
    "path": "#/book/{listen}",
    "steps": [
      {
        "text": "Tìm chữ trong sách"
      }
    ],
    "probe": {
      "selector": "input[type=search]",
      "type": "input"
    },
    "background": {
      "text": "Tìm chữ trong sách"
    }
  },
  {
    "name": "Listen mobile - Edit metadata",
    "path": "#/book/{listen}",
    "steps": [
      {
        "text": "Thêm việc với sách",
        "exact": true
      },
      {
        "text": "Sửa thông tin"
      }
    ],
    "probe": {
      "selector": "input[aria-label='Tác giả']",
      "type": "input"
    },
    "background": {
      "text": "Thêm việc với sách",
      "exact": true
    }
  },
  {
    "name": "Listen mobile - Rename chapter",
    "path": "#/book/{listen}",
    "steps": [
      {
        "selector": "button[aria-label^='Tuỳ chọn Ch']"
      },
      {
        "text": "Đổi tên chương"
      }
    ],
    "probe": {
      "selector": "input",
      "type": "input"
    },
    "background": {
      "text": "Thêm việc với sách",
      "exact": true
    }
  },
  {
    "name": "Listen mobile - New listening profile",
    "path": "#/book/{listen}",
    "steps": [
      {
        "text": "Thêm việc với sách",
        "exact": true
      },
      {
        "text": "Hồ sơ mới"
      }
    ],
    "probe": {
      "selector": "input[aria-label='Tên hồ sơ']",
      "type": "input"
    },
    "background": {
      "text": "Thêm việc với sách",
      "exact": true
    }
  },
  {
    "name": "Listen mobile - Rename listening profile",
    "path": "#/book/{listen}",
    "steps": [
      {
        "text": "Thêm việc với sách",
        "exact": true
      },
      {
        "text": "Đổi tên hồ sơ"
      }
    ],
    "probe": {
      "selector": "input[aria-label='Tên hồ sơ']",
      "type": "input"
    },
    "background": {
      "text": "Thêm việc với sách",
      "exact": true
    }
  },
  {
    "name": "Listen mobile - Delete profile confirmation",
    "path": "#/book/{listen}",
    "steps": [
      {
        "text": "Thêm việc với sách",
        "exact": true
      },
      {
        "text": "Xoá hồ sơ…",
        "exact": true
      }
    ],
    "probe": {
      "text": "Huỷ",
      "exact": true,
      "closes": true
    },
    "background": {
      "text": "Thêm việc với sách",
      "exact": true
    }
  },
  {
    "name": "Studio desktop - Rename project",
    "viewport": [
      1280,
      900
    ],
    "path": "#/studio/{studio}",
    "steps": [
      {
        "text": "Tuỳ chọn dự án Tap Studio Fixture"
      },
      {
        "text": "Đổi tên…",
        "exact": true
      }
    ],
    "probe": {
      "selector": "#rename-book-title",
      "type": "input"
    },
    "background": {
      "text": "Tuỳ chọn dự án Tap Studio Fixture"
    }
  },
  {
    "name": "Studio mobile - Delivery sheet",
    "path": "#/studio/{studio}?tab=script",
    "steps": [
      {
        "selector": "[data-line=\"tap-ui-line-1\"] p"
      },
      {
        "selector": "button[aria-label^=\"Cách đọc:\"]"
      }
    ],
    "probe": {
      "text": "Lời kể",
      "exact": true
    },
    "background": {
      "text": "Tuỳ chọn dự án Tap Studio Fixture"
    }
  },
  {
    "name": "Player mobile - Speed",
    "path": "#/book/{listen}",
    "steps": [
      {
        "selector": "[data-book-primary]"
      },
      {
        "text": "Mở màn hình đang nghe",
        "exact": true
      },
      {
        "text": "Tốc độ đọc"
      }
    ],
    "probe": {
      "text": "1,3×",
      "exact": true,
      "closes": true,
      "expect": "[...document.querySelectorAll('button')].some(e=>tapAudit.visible(e)&&e.getAttribute('aria-label')?.includes('Tốc độ đọc: 1,3'))"
    },
    "background": {
      "text": "Thêm tuỳ chọn",
      "exact": true
    },
    "touchProbe": {
      "text": "1,5×",
      "exact": true,
      "closes": true,
      "expect": "[...document.querySelectorAll('button')].some(e=>tapAudit.visible(e)&&e.getAttribute('aria-label')?.includes('Tốc độ đọc: 1,5'))"
    },
    "reopenSteps": [
      {
        "text": "Tốc độ đọc"
      }
    ]
  },
  {
    "name": "Player mobile - Sleep timer",
    "path": "#/book/{listen}",
    "steps": [
      {
        "selector": "[data-book-primary]"
      },
      {
        "text": "Mở màn hình đang nghe",
        "exact": true
      },
      {
        "text": "Hẹn giờ"
      }
    ],
    "probe": {
      "text": "15 phút",
      "exact": true,
      "closes": true,
      "expect": "[...document.querySelectorAll('button')].some(e=>tapAudit.visible(e)&&/15 phút/.test(e.getAttribute('aria-label')||''))"
    },
    "background": {
      "text": "Thêm tuỳ chọn",
      "exact": true
    },
    "touchProbe": {
      "text": "30 phút",
      "exact": true,
      "closes": true,
      "expect": "[...document.querySelectorAll('button')].some(e=>tapAudit.visible(e)&&/30 phút/.test(e.getAttribute('aria-label')||''))"
    },
    "reopenSteps": [
      {
        "text": "Hẹn giờ"
      }
    ]
  },
  {
    "name": "Player mobile - More options",
    "path": "#/book/{listen}",
    "steps": [
      {
        "selector": "[data-book-primary]"
      },
      {
        "text": "Mở màn hình đang nghe",
        "exact": true
      },
      {
        "text": "Thêm tuỳ chọn",
        "exact": true
      }
    ],
    "probe": {
      "text": "Dấu trang",
      "exact": true,
      "closes": true,
      "expect": "[...document.querySelectorAll('[role=dialog] h2')].some(e=>e.textContent==='Dấu trang')"
    },
    "background": {
      "text": "Thêm tuỳ chọn",
      "exact": true
    },
    "reopenSteps": [
      {
        "text": "Thêm tuỳ chọn",
        "exact": true
      }
    ]
  },
  {
    "name": "Player mobile - Voice",
    "path": "#/book/{listen}",
    "steps": [
      {
        "selector": "[data-book-primary]"
      },
      {
        "text": "Mở màn hình đang nghe",
        "exact": true
      },
      {
        "text": "Thêm tuỳ chọn",
        "exact": true
      },
      {
        "text": "Giọng đọc"
      }
    ],
    "probe": {
      "text": "Giọng thử B",
      "closes": false,
      "expect": "([...document.querySelectorAll('button')].some(e=>e.getAttribute('aria-label')==='Giọng đọc: Giọng thử B')) && !document.querySelector('[data-player-inline] > button[aria-expanded=true]')"
    },
    "background": {
      "text": "Thêm tuỳ chọn",
      "exact": true
    },
    "touchProbe": {
      "text": "Giọng thử A",
      "closes": false,
      "expect": "([...document.querySelectorAll('button')].some(e=>e.getAttribute('aria-label')==='Giọng đọc: Giọng thử A')) && !document.querySelector('[data-player-inline] > button[aria-expanded=true]')"
    },
    "reopenSteps": [
      {
        "text": "Thêm tuỳ chọn",
        "exact": true
      },
      {
        "text": "Giọng đọc"
      }
    ],
    "inlineReopen": [
      {
        "text": "Giọng đọc"
      }
    ]
  },
