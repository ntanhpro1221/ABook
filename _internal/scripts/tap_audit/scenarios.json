  {
    "name": "Player mobile - Chapters",
    "path": "#/book/{listen}",
    "steps": [
      {
        "selector": "[data-book-primary]"
      },
      {
        "text": "Mở màn hình đang nghe",
        "exact": true
      },
      {
        "text": "Chương",
        "exact": true
      }
    ],
    "probe": {
      "text": "Chương 2",
      "expect": "[...__tapLayer.querySelectorAll('button[aria-current=true]')].some(e=>e.textContent.includes('Chương 2'))"
    },
    "background": {
      "text": "Thêm tuỳ chọn",
      "exact": true
    },
    "touchProbe": {
      "text": "Chương 1",
      "expect": "[...__tapLayer.querySelectorAll('button[aria-current=true]')].some(e=>e.textContent.includes('Chương 1'))"
    },
    "reopenSteps": [
      {
        "text": "Chương",
        "exact": true
      }
    ]
  },
