  {
    "name": "Listen mobile - Listening profile picker",
    "path": "#/book/{profiles}",
    "steps": [
      {
        "text": "Hồ sơ nghe:"
      }
    ],
    "probe": {
      "text": "Mặc định",
      "closes": true,
      "expect": "[...document.querySelectorAll('button')].some(e=>tapAudit.label(e).startsWith('Hồ sơ nghe:')&&tapAudit.label(e).includes('Mặc định'))"
    },
    "background": {
      "text": "Thêm việc với sách",
      "exact": true
    },
    "touchProbe": {
      "text": "Hồ sơ thử thứ hai",
