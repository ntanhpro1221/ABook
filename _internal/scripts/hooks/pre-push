#!/bin/sh
# Scan each proposed tip, including files absent from the current checkout.
set -eu
root=$(git rev-parse --show-toplevel)
common=$(git rev-parse --path-format=absolute --git-common-dir)
python_bin=${ABOOK_PYTHON:-"$root/_internal/runtime/.venv/Scripts/python.exe"}
if [ ! -f "$python_bin" ]; then
    python_bin=${ABOOK_PYTHON:-"$(dirname "$common")/_internal/runtime/.venv/Scripts/python.exe"}
fi
if [ ! -f "$python_bin" ]; then
    printf '%s\n' 'pre-push: set ABOOK_PYTHON to the project Python interpreter' >&2
    exit 1
fi
cd "$root"
scanned=" "
while read -r local_ref local_oid remote_ref remote_oid; do
    case "$local_oid" in *[!0]*) ;; *) continue ;; esac
    case "$scanned" in *" $local_oid "*) continue ;; esac
    printf 'pre-push: scanning %s\n' "$local_ref" >&2
    "$python_bin" -X utf8 "$root/_internal/scripts/leak_scan.py" --rev "$local_oid"
    scanned="$scanned$local_oid "
done
