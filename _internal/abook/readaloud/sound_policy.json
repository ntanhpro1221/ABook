{
  "version": 1,
  "min_run": 3,
  "max_laugh_syllables": 8,
  "note_pattern": "\\[note[0-9]+\\]",
  "frames": "_~\"'“”‘’()[]{}«»!?.,;…",
  "emoticons": {"xd": "ha ha", ":d": "ha ha", ":v": "hề hề"},
  "laugh_pattern": "[aeiou]?(?:(?:h(?:a+|e+|i+|o+|u+)|f[uw]?(?:a+|e+|i+|o+|u+))){2,}h?",
  "laugh_atom": "h(?:a+|e+|i+|o+|u+)|f[uw]?(?:a+|e+|i+|o+|u+)",
  "laugh_vowels": {"a": "ha", "e": "hê", "i": "hy", "o": "hô", "u": "hu"},
  "laugh_leads": {"a": "a", "e": "ê", "i": "i", "o": "ô", "u": "u"},
  "english_collisions": {"he": "hê", "hi": "hy", "me": "mê", "i": "i"},
  "english_safe": ["a", "ba", "ca", "ha", "ma", "mi", "na", "ni", "ta", "xa"],
  "nasal_pattern": "[u]+m+[u]+",
  "breath_pattern": "(?:[hkg]+[wy]?[aeiou]+[hkg]*|[aeiou]+[hkg]+)",
  "palatal_pattern": "[kgn]+y[aeiou]+h*",
  "growl_pattern": "r+[oa]+r+",
  "hiss_pattern": "[aeiou]+[zs]+",
  "vowels": "aeiou",
  "max_acronym_letters": 32
}
