<?xml version="1.0" encoding="utf-8"?>
<!-- Chồng lên manifest chính CHỈ khi dựng với -PnativeUi (app/build.gradle): NativeActivity (Compose) thành màn mở app, MainActivity (WebView) thôi là
     launcher VÀ mất mọi bộ lọc "Mở bằng" / chia sẻ file sách: NativeActivity nhận chúng (NativeActivity.receive -> hàng nhập sách "Thêm sách"). Các bộ lọc ở NativeActivity
     chép nguyên từ manifest chính (NativeManifestFiltersTest giữ hai bản khớp nhau). Không cờ thì file này không được gắn. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- Macrobenchmark / baseline profile đo bản release không gỡ lỗi được: cần profileable (shell). Chỉ ở bản -PnativeUi. -->
        <profileable android:shell="true" tools:targetApi="29" />

        <activity
            android:name=".MainActivity"
            tools:node="merge">
            <intent-filter tools:node="removeAll" />
        </activity>

        <activity
            android:name=".ui.NativeActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density|fontScale"
            android:enableOnBackInvokedCallback="true"
            android:exported="true"
            android:label="@string/title_activity_main"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:theme="@style/AppTheme.NoActionBarLaunch">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- File sách .abook (webui/bookfile.py, BookFileImport.kt) và file dự án .abookproj (webui/projectfile.py - điện
                 thoại chỉ nhập phần nghe của nó): mở từ trình quản lý file, trình duyệt, Drive.
                 Nơi gửi biết loại riêng của ta thì khớp bộ lọc đầu; không biết (đuôi lạ -> octet-stream/zip) thì khớp
                 theo đuôi file ở bộ lọc sau. Không nhận "*/*": app không chen vào mọi lệnh "Mở bằng". -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/vnd.ngdtuanh.abook+zip" />
                <data android:mimeType="application/vnd.ngdtuanh.abookproj+zip" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
                <data android:pathPattern=".*\\.abook" />
                <data android:pathPattern=".*\\..*\\.abook" />
                <data android:pathPattern=".*\\..*\\..*\\.abook" />
                <data android:pathPattern=".*\\.abookproj" />
                <data android:pathPattern=".*\\..*\\.abookproj" />
                <data android:pathPattern=".*\\..*\\..*\\.abookproj" />
            </intent-filter>
            <!-- Chia sẻ một file sách tới app (Zalo, Telegram, email). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.ngdtuanh.abook+zip" />
                <data android:mimeType="application/vnd.ngdtuanh.abookproj+zip" />
                <!-- Zalo, Drive, email hay đặt kiểu chung cho file lạ: LibraryPlugin.openFrom kiểm tên / đầu file, không phải file sách thì báo rõ. -->
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
            </intent-filter>
            <!-- EPUB / Word / PDF / TXT từ app khác ("Mở bằng", chia sẻ tới app): mở bước xem trước của "Thêm sách từ file…"
                 (LibraryPlugin.openFrom). Chỉ là một lựa chọn trong "Mở bằng" - không BROWSABLE, không nhận "*/*". -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
