<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Nền của chủ đề: sáng ở values, tối ở values-night (bộ chọn tài nguyên làm việc của DayNight). Chủ đề nền tảng, không AppCompat: mọi thứ nhìn thấy là Compose. -->
    <style name="BaseTheme" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Chủ đề của app và của cửa sổ sau màn chờ. Thanh trạng thái, thanh điều hướng và nền cửa sổ lấy app_bg (khớp ui/src/styles.css, xem colors.xml). -->
    <style name="AppTheme" parent="BaseTheme">
        <item name="android:textColorPrimary">@color/app_text</item>
        <item name="android:textColorSecondary">@color/app_text_secondary</item>
        <item name="android:windowBackground">@color/app_bg</item>
        <item name="android:statusBarColor">@color/app_bg</item>
        <item name="android:navigationBarColor">@color/app_bg</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_system_bars</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:windowBackground">@color/app_bg</item>
        <item name="windowSplashScreenBackground">@color/app_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
        <item name="android:statusBarColor">@color/app_bg</item>
        <item name="android:navigationBarColor">@color/app_bg</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_system_bars</item>
    </style>
</resources>
